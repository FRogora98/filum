    "/sample/memory/consolidate": {
      "post": {
        "tags": [
          "memory"
        ],
        "summary": "Tidy the memory now: a pass over what was said since the last one, adding what the conversations did not write.",
        "operationId": "filum.memory.consolidate",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsolidationResultDto"
