<Project>

  <!-- Central Package Management: every PackageReference resolves its version here. The engine depends only on
       abstractions: the model is the host's (filum-mcp) or the one a standalone use plugs in (samples/Filum.Standalone). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- The engine -->
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.5.2" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />

    <!-- The isolated interpreter of compute_run: pure .NET, no native code, BSD-2 -->
    <PackageVersion Include="Jint" Version="4.16.4" />

    <!-- Filum.Embeddings: a small embedding model on the CPU, optional for every host -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.0" />

    <!-- filum-mcp: the official C# MCP SDK and the generic host (stdio, logs on stderr) -->
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />

    <!-- The standalone sample's function calling (Microsoft.Extensions.AI); the evals' judge and references (OpenAI),
         run by hand only, never by the engine -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.5.2" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.5.2" />
    <PackageVersion Include="OpenAI" Version="2.10.0" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <!-- Property tests (spec 039); BSD-3-Clause, with FSharp.Core (MIT). Test projects only. -->
    <PackageVersion Include="FsCheck.Xunit" Version="3.4.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <!-- The architecture tests read the sources with the C# parser (BUILD-02: file, method and type layout) -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />

    <!-- The public API, tracked in PublicAPI.*.txt (CODING-STANDARD SDK-02) -->
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

</Project>
