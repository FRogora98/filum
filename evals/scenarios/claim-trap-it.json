{
  "id": "claim-trap-it",
  "language": "it",
  "description": "Una lista chiesta va creata davvero, e in una chat nuova Filum la ritrova senza dichiarare salvataggi che non ha fatto.",
  "turns": [
    {
      "chat": "a",
      "message": "Ciao, fammi una lista di film da guardare: Le iene, The Wolf of Wall Street, Shutter Island.",
      "expect": [
        {
          "type": "wrote"
        },
        {
          "type": "rows",
          "name_any": [
            "film",
            "movie",
            "watch",
            "guard",
            "vedere",
            "cinema"
          ],
          "count": 3,
          "contain": [
            "iene",
            "wolf",
            "shutter"
          ]
        }
      ]
    },
    {
      "chat": "b",
      "message": "Mi hai salvato la lista dei film?",
      "expect": [
        {
          "type": "no_write"
        },
        {
          "type": "answer_contains",
          "any": [
            "iene",
            "shutter",
            "wolf",
            "sì",
            "yes",
            "ce l'ho",
            "salvata",
            "c'è"
          ]
        }
      ]
    }
  ]
}
