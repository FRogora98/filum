  "components": {
    "schemas": {
      "ConsolidationResultDto": {
        "required": [
          "events",
          "changes",
          "proposals",
          "usage"
        ],
        "type": "object",
        "properties": {
          "events": {
            "type": "integer",
            "format": "int32"
          },
          "changes": {
            "type": "integer",
            "format": "int32"
          },
          "proposals": {
            "type": "integer",
            "format": "int32"
          },
          "usage": {
            "$ref": "#/components/schemas/UsageDto"
          }
        }
      },
      "ConversationDto": {
        "required": [
          "id",
          "title",
          "model",
          "preview",
          "createdAt",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "preview": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ForgetRequest": {
        "required": [
          "conversationId"
        ],
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ForgetResultDto": {
        "required": [
          "events",
          "files",
          "factRows"
        ],
        "type": "object",
        "properties": {
          "events": {
            "type": "integer",
            "format": "int32"
          },
          "files": {
            "type": "integer",
            "format": "int32"
          },
          "factRows": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "MemoryChangeDto": {
        "required": [
          "revisionId",
          "path",
          "lineCount",
          "rowCount"
        ],
        "type": "object",
        "properties": {
          "revisionId": {
            "type": "integer",
            "format": "int64"
          },
          "path": {
            "type": "string"
          },
          "lineCount": {
            "type": "integer",
            "format": "int32"
          },
          "rowCount": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          }
        }
      },
      "MemoryFileDetailDto": {
        "required": [
          "path",
          "kind",
          "sizeBytes",
          "lineCount",
          "sensitivity",
          "updatedAt",
          "header",
          "rowCount",
          "content",
          "origin"
        ],
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "integer",
            "format": "int32"
          },
          "lineCount": {
            "type": "integer",
            "format": "int32"
          },
          "sensitivity": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "header": {
            "type": [
              "null",
              "string"
