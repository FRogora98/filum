  "paths": {
    "/sample/models": {
      "get": {
        "tags": [
          "models"
        ],
        "summary": "The models a message may name, with their prices; one is the default.",
        "operationId": "filum.models.list",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ModelDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sample/conversations": {
      "get": {
        "tags": [
          "conversations"
        ],
        "summary": "The person\u0027s conversations, the most recent first.",
        "operationId": "filum.conversations.list",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
