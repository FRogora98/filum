{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "sample": ""
  },
  "Agent": {
    "Name": "Sample",
    "AllowModelChoice": true,
    "TimeZone": "UTC"
  },
  "Memory": {
    "PackPath": "../../packs/example"
  },
  "OpenAI": {
    "Model": "gpt-5.4-mini",
    "TimeoutSeconds": 60
  },
  "Providers": {
    "openai": {
      "BaseUrl": "",
      "DenyDataCollection": false
    }
  },
  "Models": [
    {
      "Id": "gpt-5.4-mini",
      "Provider": "openai",
      "Name": "GPT-5.4 mini",
      "Description": "Fast and cheap, for everyday messages",
      "InputPricePerMillionUsd": 0.75,
      "OutputPricePerMillionUsd": 4.5
    },
    {
      "Id": "gpt-5.4-nano",
      "Provider": "openai",
      "Name": "GPT-5.4 nano",
      "Description": "Cheapest, for quick notes",
      "InputPricePerMillionUsd": 0.2,
      "OutputPricePerMillionUsd": 1.25
    }
  ],
  "Usage": {
    "MonthlyBudgetUsd": 10
  },
  "Reliability": {
    "CheckModel": "",
    "EscalationModel": ""
  }
}
