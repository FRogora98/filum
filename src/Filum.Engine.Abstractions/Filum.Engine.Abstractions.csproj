<Project Sdk="Microsoft.NET.Sdk">

  <!-- What a host or a plugin of the engine needs to know, and nothing else: the ports (the store and its roles, the
       embedder, the event gate), the models they exchange, the options and the constants. No implementation and no
       package: a store for another database depends on this alone. -->
  <PropertyGroup>
    <RootNamespace>Filum.Engine.Abstractions</RootNamespace>
    <Version>1.0.0</Version>
    <!-- A library documents every public type and member (CODING-STANDARD DOC-02): CS1591 is on here. -->
    <NoWarn>$(NoWarn.Replace(';CS1591', ''))</NoWarn>
  </PropertyGroup>

  <!-- The public API is tracked in PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt (CODING-STANDARD SDK-02). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
