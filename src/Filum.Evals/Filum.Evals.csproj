<Project Sdk="Microsoft.NET.Sdk">

  <!-- Run by hand, never by dotnet test or CI: it plays scenarios against a running host of the engine (or a real agent
       with filum-mcp) with real models, and costs real money or the agent's own subscription. See the README, "Evals". -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>filum-evals</AssemblyName>
    <RootNamespace>Filum.Evals</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="OpenAI" />
  </ItemGroup>

  <ItemGroup>
    <!-- The DTOs of the endpoint groups; the runner talks to a host over HTTP only. -->
    <ProjectReference Include="..\Filum.Agent.Http\Filum.Agent.Http.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\evals\scenarios\*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="scenarios" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Filum.Engine" />
    <Using Include="Filum.Agent" />
    <Using Include="Filum.Agent.Http" />
  </ItemGroup>

</Project>
